# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Git
.git
.gitignore

# Secrets — tuyệt đối không vào image
.env
.env.*
!.env.example
*.pem
*.key

# Python / môi trường ảo
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# Không cần lúc chạy
tests/
screenshots/
mydocs/
solution/
.github/
*.md
*.log
Dockerfile
docker-compose.yml
nginx/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
